//General parameters for nextflow execution:
process.executor = "slurm"
process.clusterOptions = '--requeue'
//SLURM general submission options:
executor {
   queueSize = 300
   submitRateLimit = '100/5min'
}

//Input parameters for the pipeline:
//Directory for final outputs:
params.run_name = "basic_1"
params.path_name = "basic"
params.output_prefix = "/gpfs/gibbs/pi/tucci/cl2549/03_ArchaicMethodComparison/preliminary"
params.output_dir = "${params.output_prefix}/${params.path_name}/${params.run_name}/ArchaicSeeker2"

//Glob for the per-chromosome modern VCFs:
params.modern_vcf_glob = "${params.output_prefix}/${params.path_name}/data/Modern_${params.run_name}_chr*.vcf.gz"
//Regex for parsing the chromosome out of the VCF name:
params.modern_vcf_regex = ~/_chr(\p{Alnum}+)/

//Glob for the per-chromosome archaic VCFs:
params.arc_vcf_glob = "${params.output_prefix}/${params.path_name}/data/Archaic_${params.run_name}_chr*.vcf.gz"
//Regex for parsing the chromosome out of the VCF name:
params.arc_vcf_regex = ~/_chr(\p{Alnum}+)/

//Path to metadata file for archaics:
params.arc_metadata_file = "${params.output_prefix}/files/Archaic.metadata"

//Path to freeze metadata file:
params.metadata_file = "${params.output_prefix}/files/Modern.metadata"
//Include/filter expression to apply to input VCFs:
params.input_filter_str = ''
//Sample ID file for exclusion:
params.samples_to_exclude = "${params.output_prefix}/files/samples_to_exclude.txt"

//Metadata structure information for AS2 sample selection:
//Sample ID column name in metadata file:
params.id_colname = "Sample"
//Outgroup name to use:
params.AS_outgroup_colname = "Population"
params.AS_outgroup = "AFR"
//Target group column name:
params.AS_target_colname = "Population"

//File listing ArchaicSeeker2 target populations (one pop per line):
params.target_pops_file = "${params.output_prefix}/files/Sprime.target"

//Archaic sample IDs:
//Archaic hominin groups represented in archaic VCFs:
params.archaic_groups = "Neandertal"
//Archaic hominin samples to consider individually in archaic VCFs:
params.archaic_indivs = "tsk_200"
//Short names for these archaic hominin samples:
params.archaic_shortnames = "Arc"
//Options for NEA: AltaiNeandertal, Vindija33.19, Chagyrskaya-Phalanx
params.nea_id = "tsk_200"
//Leave den_id empty if no second archaic is being used:
params.den_id = ""

//AS2 model Newick tree:
//ADJUST THIS FOR SIMULATIONS:
//Note that this default tree is based on Altai Neanderthal, not Vindija or Chagyrskaya
params.AS2_model_tree = '((Outgroup:100,Modern:100):557.5,(Denisova:340,Neanderthal:362.5):237.5);'

//ADJUST THESE FOR SIMULATIONS:
//AS2 initial proportion of introgression:
//Default: 0.02
params.AS2_intro_proportion = "0.02"
//AS2 introgression time in generations:
//Default: 2000
params.AS2_intro_time = "2000"
//AS2 emission probability initial value:
//Default: 0.99
params.AS2_emission_prob = "0.99"

//Run MultiWaver2.1?
params.run_multiwaver = false
//Use all MW2 defaults, don't specify any optional arguments:
params.MW2_defaults = false
//MW2 lower bound for tract length:
//Default: 0
params.MW2_lower_bound = "0.00015"
//MW2 significance threshold for the LRT:
//Default: 0.001
params.MW2_LRT_alpha = "0.001"
//MW2 number of bootstraps:
//Default: 100
params.MW2_n_bootstraps = "100"
//MW2 tolerance epsilon for convergence:
//Default: 1.0e-6
params.MW2_tolerance = "1.0e-6"
//MW2 minimum survival proportion:
//Default: 0.05
params.MW2_min_surv_prop = "0.05"
//MW2 maximum number of iterations:
//Default: 10000
params.MW2_max_iter = "10000"

//Debugging options:
trace {
   enabled = true
   fields = 'task_id,name,hash,status,exit,cpus,memory,time,submit,start,complete,duration,%cpu,%mem,peak_rss,workdir'
   file = "${params.output_dir}/${params.run_name}_AS2_nextflow_trace.txt"
   raw = true
   overwrite = true
}

//Reference-related parameters for the pipeline:
profiles {
   hs37d5 {
      //List of autosomes to use:
      params.autosomes = "1"
      //CHANGE THESE:
      //Recombination rate maps to use:
      params.recmap_glob = "${params.output_dir}/genetic_map/genetic_map_GRCh37_chr*.txt"
      //Regex for parsing chromosome from rec map filenames:
      params.recmap_regex = ~/_chr([0-9]+)$/
      //Chimp allele FASTA glob:
      params.pantro_glob = "/gpfs/gibbs/pi/tucci/pfr8/human_ancestor/ArchaicSeeker2.0/PrimatesGenome/chr*.hg19.chimp.fa.gz"
      //Chimp allele FASTA regex:
      params.pantro_regex = ~/chr([0-9]+)/
      //TAKEN FROM hmmix TEMPLATE:
      //Ancestral allele FASTA glob:
      params.anc_glob = "${params.output_prefix}/${params.path_name}/data/${params.run_name}_homo_sapiens_ancestor_*.fa"
      //Ancestral allele FASTA regex:
      params.anc_regex = ~/_homo_sapiens_ancestor_(\p{Alnum}+)$/
      //Ref allele FASTA glob:
      params.ref_glob = "${params.output_prefix}/${params.path_name}/data/${params.run_name}_refgenome_chr*.fa"
      //Ref allele FASTA regex:
      params.ref_regex = ~/_chr(\p{Alnum}+)$/
   }

   mccleary {
      params.mod_bcftools = "BCFtools/1.16-GCCcore-10.2.0"
      params.mod_htslib = "HTSlib/1.16-GCCcore-10.2.0"
      params.mod_ArchaicSeeker = "ArchaicSeeker/2.0"
      params.mod_bedtools = "BEDTools/2.30.0-GCCcore-10.2.0"
   }
}

//SLURM submission parameters:
//Memory specified in GiB unless otherwise indicated
//Reformatting of recombination rate map files:
//Memory in MiB
//Adds 512 MiB on retry
//Timeout to 24h on retry
//Max 1 retry
params.recmap_cpus = 1
params.recmap_mem = 256
params.recmap_mem_increment = 512
params.recmap_timeout = '1h'
params.recmap_retry_timeout = '24h'
params.recmap_queue = 'day'
params.recmap_retry_queue = 'day'
//VCF subsetting for ArchaicSeeker2
//Adds 8 GiB on retry
//Timeout to 24h on retry
//Max 1 retry
params.ASsubset_cpus = 1
params.ASsubset_mem = 1
params.ASsubset_mem_increment = 8
params.ASsubset_timeout = '3h'
params.ASsubset_retry_timeout = '24h'
params.ASsubset_queue = 'day'
params.ASsubset_retry_queue = 'day'
//ArchaicSeeker2.0
//Adds 16 GiB on retry
//Timeout to 24h on retry
//Max 1 retry
params.AS2_cpus = 1
params.AS2_mem = 4
params.AS2_mem_increment = 16
params.AS2_timeout = '24h'
params.AS2_retry_timeout = '24h'
params.AS2_queue = 'day'
params.AS2_retry_queue = 'day'
//MultiWaver2.1
//Adds 16 GiB on retry
//Timeout to 24h on retry
//Max 1 retry
params.MW2_cpus = 1
params.MW2_mem = 1
params.MW2_mem_increment = 16
params.MW2_timeout = '24h'
params.MW2_retry_timeout = '24h'
params.MW2_queue = 'day'
params.MW2_retry_queue = 'day'
//AS2 match rates
//Adds 4 GiB on retry
//Timeout to 24h on retry
//Max 1 retry
params.matchrate_cpus = 1
params.matchrate_mem = 2
params.matchrate_mem_increment = 4
params.matchrate_timeout = '2h'
params.matchrate_retry_timeout = '24h'
params.matchrate_queue = 'day'
params.matchrate_retry_queue = 'day'
//Combine outputs across targets and chromosomes
//Adds 16 GiB on retry
//Timeout to 24h on retry
//Max 1 retry
params.catouts_cpus = 1
params.catouts_mem = 1
params.catouts_mem_increment = 16
params.catouts_timeout = '2h'
params.catouts_retry_timeout = '24h'
params.catouts_queue = 'day'
params.catouts_retry_queue = 'day'
